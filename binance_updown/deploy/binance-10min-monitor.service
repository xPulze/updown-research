[Unit]
Description=Binance 10-min Continuation Monitor (Phase 1 - accuracy tracking only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/updown
EnvironmentFile=-/opt/updown/.env
ExecStart=/opt/updown/.venv/bin/python3 /opt/updown/binance_updown/binance_multi_horizon_monitor.py --horizon 10
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
